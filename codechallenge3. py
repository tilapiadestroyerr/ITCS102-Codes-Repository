Sender_Name = input("Name of the Sender? --> ")
Type_of_Item = input("Type of Item? ---> ")
weight = float(input("Weight of the object? (in kg) ---> "))
Is_Fragile = bool(eval(input("Is it Fragile? (True or False) ---> ")))
distance = float(input("distance (In km) ---- > "))
is_express = bool(eval(input("Is it Express? (True or False) --> ")))
is_international = bool(eval(input("Is it International? (True or False ) --> ")))


#Base Cost Calculation

base_cost = (weight * 2.5) + (distance * .15)


# If package is Free shipping

if  weight <= 2 and distance <= 100 and is_express == False and is_international == False :
	print("Free Shipping")
	Total = 0
	

# If package is International Express

elif is_international == True and is_express == True :
	print("Package is International")
	Total = (base_cost * 1.4) + 50


# If package is Express or Heavy International

elif is_express == True or (is_international == True and weight > 20) : 
	print("Package is Express or Heavy International")
	Total = (base_cost * 1.2) + 25

# If package is  Oversized
elif weight > 30 or distance > 1000 : 
	print("Oversized")
	Total = base_cost + 30
#Standard rate

else :
	Total = base_cost
	print("Standard rate is applied")


print("--------------------------")
print("Name of the Sender : ", Sender_Name)
print("Type of Item : ", Type_of_Item )
print("Total Output  : PHP ", Total)
